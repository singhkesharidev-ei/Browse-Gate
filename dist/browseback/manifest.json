{
  "manifest_version": 3,
  "name": "BrowseGate",
  "version": "0.6.0",
  "description": "A local-first research assistant for your browsing workflow.",
  "minimum_chrome_version": "116",
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self';" },
  "icons": { "128": "src/icons/browsegate-128.png" },
  "permissions": ["sidePanel", "storage", "tabs", "alarms", "notifications"],
  "optional_permissions": ["clipboardRead", "clipboardWrite", "history"],
  "background": { "service_worker": "src/background/service-worker.js", "type": "module" },
  "action": {
    "default_icon": { "128": "src/icons/browsegate-128.png" },
    "default_title": "Quick Save with BrowseGate",
    "default_popup": "src/popup/popup.html"
  },
  "side_panel": {
    "default_path": "src/sidepanel/sidepanel.html"
  }
}
